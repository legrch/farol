{
  "name": "farol-next-preview",
  "version": "0.1.0-preview.0",
  "private": true,
  "description": "Isolated local preview of the Farol Next modular monolith.",
  "type": "module",
  "engines": {
    "node": "24.20.0 || 26.7.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "check:toolchain": "node tooling/check-toolchain.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node tooling/lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture": "node tooling/check-architecture.mjs",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture",
    "test:unit": "vitest run tests/unit tests/integration",
    "test:coverage": "vitest run --coverage",
    "hunt:selftest": "vitest run tests/hunt/selftest.test.ts",
    "hunt:proof": "vitest run tests/hunt/proof.test.ts",
    "hunt:model": "vitest run tests/hunt/model.test.ts",
    "hunt:report": "node tooling/hunt-report.mjs",
    "build": "node tooling/build.mjs",
    "package": "node -e \"console.error('A candidate is built only by: task next:package (clean environment, isolated wrapper).'); process.exit(1)\"",
    "verify:package": "node tooling/verify-package.mjs",
    "promote": "node tooling/promote-preview.mjs",
    "preview": "electron dist/app/main.cjs",
    "test:e2e:dev": "npm run build && node tests/e2e/preview.e2e.mjs --development",
    "test:e2e:dev-onboarding-startup": "npm run build && node tests/e2e/dev-onboarding-startup.e2e.mjs",
    "test:e2e:dev-route-b-host": "node tests/e2e/dev-route-b-host.e2e.mjs",
    "test:e2e:soak": "npm run build && node tests/e2e/preview.e2e.mjs --development --lifecycle-soak",
    "test:e2e:soak:package": "node tests/e2e/preview.e2e.mjs --lifecycle-soak",
    "test:e2e:persistence-fault": "npm run build && node tests/e2e/preview.e2e.mjs --development --persistence-fault",
    "test:e2e:two-generation-state": "node tests/e2e/preview.e2e.mjs --two-generation-state",
    "test:e2e": "node tests/e2e/preview.e2e.mjs",
    "test:e2e:computer": "node tests/e2e/readonly-computer-mcp.e2e.mjs && node tests/e2e/mutable-computer-mcp.e2e.mjs",
    "test:e2e:computer:package": "node tests/e2e/readonly-computer-mcp.e2e.mjs --packaged && node tests/e2e/mutable-computer-mcp.e2e.mjs --packaged",
    "ci": "npm run check:toolchain && npm run typecheck && npm run lint && npm run format:check && npm run architecture && npm run test:coverage && npm run hunt:report"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "electron": "44.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.12.1",
    "@vitest/coverage-v8": "5.0.0",
    "esbuild": "0.28.2",
    "fast-check": "4.9.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
