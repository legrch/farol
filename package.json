{
  "name": "farol",
  "version": "0.5.1",
  "farolRelease": {
    "updateChannel": "github-stable",
    "buildVersion": "57"
  },
  "private": true,
  "description": "Isolated local preview of the Farol modular monolith.",
  "type": "module",
  "engines": {
    "node": "24.20.0 || 26.7.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "check:toolchain": "node tooling/check-toolchain.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "lint": "node tooling/lint.mjs && node tooling/lint-renderer.mjs",
    "format": "prettier --write . !.claude/worktrees",
    "format:check": "prettier --check . !.claude/worktrees",
    "architecture": "node tooling/check-architecture.mjs",
    "runtime:check": "node tooling/check-runtime-launches.mjs",
    "docs:check": "python3 -B docs/tools/check.py && python3 -B -m unittest discover -s docs/tools -p 'test_*.py'",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture",
    "test:unit": "node tooling/test-scopes.mjs --scope=unit",
    "test:integration": "node tooling/test-scopes.mjs --scope=integration",
    "test:fast": "node tooling/test-scopes.mjs --scope=fast",
    "test:coverage": "vitest run --coverage && vitest run --config vitest.renderer.config.ts --coverage",
    "hunt:selftest": "vitest run tests/hunt/selftest.test.ts",
    "hunt:proof": "vitest run tests/hunt/proof.test.ts",
    "hunt:model": "vitest run tests/hunt/model.test.ts",
    "hunt:report": "node tooling/hunt-report.mjs",
    "build": "node tooling/build.mjs",
    "package": "node -e \"console.error('A candidate is built only by: task package (clean environment, isolated wrapper).'); process.exit(1)\"",
    "verify:package": "node tooling/verify-package.mjs",
    "promote": "node tooling/promote-preview.mjs",
    "preview": "electron _output/build/app/main.cjs",
    "preview:owner": "node tooling/owner-preview.mjs build-run",
    "preview:development": "node tooling/dev.mjs",
    "preview:plan": "node tooling/owner-preview.mjs plan",
    "preview:build": "node tooling/owner-preview.mjs build",
    "preview:run": "node tooling/owner-preview.mjs run",
    "test:e2e:dev": "node tooling/dev.mjs --check && node tests/e2e/preview.e2e.mjs --development",
    "test:e2e:dev-onboarding-startup": "node tooling/dev.mjs --check && node tests/e2e/dev-onboarding-startup.e2e.mjs",
    "test:e2e:dev-route-b-host": "node tests/e2e/dev-route-b-host.e2e.mjs",
    "test:e2e:soak": "node tooling/dev.mjs --check && node tests/e2e/preview.e2e.mjs --development --lifecycle-soak",
    "test:e2e:soak:package": "node tests/e2e/preview.e2e.mjs --lifecycle-soak",
    "test:e2e:persistence-fault": "node tooling/dev.mjs --check && node tests/e2e/preview.e2e.mjs --development --persistence-fault",
    "test:e2e:two-generation-state": "node tests/e2e/preview.e2e.mjs --two-generation-state",
    "test:e2e": "node tests/e2e/preview.e2e.mjs",
    "test:e2e:computer": "node tests/e2e/readonly-computer-mcp.e2e.mjs && node tests/e2e/mutable-computer-mcp.e2e.mjs && node tests/e2e/workspace-shell-mcp.e2e.mjs",
    "test:e2e:computer:package": "node tests/e2e/readonly-computer-mcp.e2e.mjs --packaged && node tests/e2e/mutable-computer-mcp.e2e.mjs --packaged && node tests/e2e/workspace-shell-mcp.e2e.mjs --packaged",
    "test:e2e:codex-task-fixture": "node tests/e2e/codex-task-mcp.e2e.mjs",
    "test:e2e:codex-task-fixture:package": "node tests/e2e/codex-task-mcp.e2e.mjs --packaged",
    "ci": "npm run check:toolchain && npm run typecheck && npm run lint && npm run format:check && npm run architecture && npm run runtime:check && npm run docs:check && npm run test:coverage && npm run hunt:report",
    "test:e2e:guided-setup": "node tests/e2e/guided-setup-selection.e2e.mjs",
    "test:e2e:guided-setup:package": "node tests/e2e/guided-setup-selection.e2e.mjs --packaged",
    "test:e2e:setup-config-error": "node tests/e2e/setup-config-error.e2e.mjs",
    "test:e2e:setup-config-error:package": "node tests/e2e/setup-config-error.e2e.mjs --packaged",
    "test:renderer": "vitest run --config vitest.renderer.config.ts",
    "test:cloud": "node tooling/test-scopes.mjs --scope=cloud",
    "ci:cloud": "npm run check:toolchain && npm run typecheck && npm run lint && npm run format:check && npm run architecture && npm run runtime:check && npm run docs:check && npm run test:cloud"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "electron": "44.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.12.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.0.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "jsdom": "30.1.1",
    "playwright-core": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "yaml": "2.8.1"
  }
}
